// 版本资源：让 exe 的「属性 → 详细信息」显示 0.1.1
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Akitsuki4852"
            VALUE "FileDescription", "NyaaFlavor - Guitar Pro / MIDI to Note Block Studio"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "InternalName", "NyaaFlavor"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "NyaaFlavor.exe"
            VALUE "ProductName", "NyaaFlavor"
            VALUE "ProductVersion", "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
